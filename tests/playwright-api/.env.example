# Base URL of the Krayin CRM application with the REST API module installed.
APP_URL=http://127.0.0.1:8000

# Admin credentials used to authenticate against the API.
# Required — the suite fails fast if either is missing.
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=

# Optional low-permission user used by the authorization (403) specs.
# Leave blank to skip those tests.
TEST_LIMITED_USER_EMAIL=
TEST_LIMITED_USER_PASSWORD=

# Device name sent with the login request (Sanctum token label).
TEST_DEVICE_NAME=playwright-api-tests

# Per-test timeout in milliseconds.
TEST_TIMEOUT=30000
